{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "authz-probe",
          "version": "0.1.0",
          "rules": [
            {
              "id": "AUTHZ-002",
              "name": "BrokenFunctionLevelAuthorization",
              "shortDescription": {
                "text": "Broken Function Level Authorization (BFLA)"
              },
              "help": {
                "text": "Implement role-based access control (RBAC): verify caller has 'admin' role before executing."
              },
              "helpUri": "https://owasp.org/API-Security/editions/2023/en/0xa5-broken-function-level-authorization/",
              "properties": {
                "precision": "very-high"
              }
            },
            {
              "id": "AUTHZ-003",
              "name": "MissingAuthentication",
              "shortDescription": {
                "text": "Unauthenticated access to protected resource"
              },
              "help": {
                "text": "Enforce authentication middleware or decorator (e.g., @login_required) on this route."
              },
              "helpUri": "https://owasp.org/API-Security/editions/2023/en/0xa2-broken-authentication/",
              "properties": {
                "precision": "very-high"
              }
            },
            {
              "id": "AUTHZ-001",
              "name": "BrokenObjectLevelAuthorization",
              "shortDescription": {
                "text": "Broken Object Level Authorization (BOLA/IDOR)"
              },
              "help": {
                "text": "Validate object ownership on every request: verify current_user.id == object.owner_id."
              },
              "helpUri": "https://owasp.org/API-Security/editions/2023/en/0xa1-broken-object-level-authorization/",
              "properties": {
                "precision": "very-high"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "AUTHZ-002",
          "level": "error",
          "message": {
            "text": "BFLA (API5:2023) detected on GET /users/v1/_debug: Administrative endpoint accessible by regular identity 'user_a'"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "users/v1/_debug"
                }
              }
            }
          ]
        },
        {
          "ruleId": "AUTHZ-002",
          "level": "error",
          "message": {
            "text": "BFLA (API5:2023) detected on GET /users/v1/_debug: Administrative endpoint accessible by regular identity 'user_b'"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "users/v1/_debug"
                }
              }
            }
          ]
        },
        {
          "ruleId": "AUTHZ-003",
          "level": "error",
          "message": {
            "text": "Missing Authentication (API2:2023) detected on GET /users/v1/_debug: Endpoint accessible without authentication (HTTP 200)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "users/v1/_debug"
                }
              }
            }
          ]
        },
        {
          "ruleId": "AUTHZ-001",
          "level": "error",
          "message": {
            "text": "BOLA / IDOR (API1:2023) detected on GET /users/v1/alice: HTTP 200 leaked data of 'alice' to unauthorized 'user_b'"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "users/v1/alice"
                }
              }
            }
          ]
        },
        {
          "ruleId": "AUTHZ-001",
          "level": "error",
          "message": {
            "text": "BOLA / IDOR (API1:2023) detected on GET /users/v1/alice: HTTP 200 leaked data of 'alice' to unauthorized 'admin'"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "users/v1/alice"
                }
              }
            }
          ]
        },
        {
          "ruleId": "AUTHZ-003",
          "level": "error",
          "message": {
            "text": "Missing Authentication (API2:2023) detected on GET /users/v1/alice: Endpoint accessible without authentication (HTTP 200)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "users/v1/alice"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}